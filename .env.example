# Ingestion Worker connection (find-rooms-ingest). Values set in the deployed
# Worker via `wrangler secret put` on the ingest project; INGEST_SHARED_SECRET
# must match that secret exactly.
INGEST_WORKER_URL=https://find-rooms-ingest.<subdomain>.workers.dev
INGEST_SHARED_SECRET=<same value as workers/ingest secret>

# Kuala Lumpur deployment — separate ingest worker (find-rooms-ingest-kl),
# separate secret. KL and Jakarta are independent deployments (ADR-0001).
INGEST_KL_WORKER_URL=https://find-rooms-ingest-kl.<subdomain>.workers.dev
INGEST_KL_SHARED_SECRET=<same value as workers/ingest-kl secret>

